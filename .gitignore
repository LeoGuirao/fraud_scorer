# Python
__pycache__/
*.py[cod]
*.egg-info/
.dist-info/
.pytest_cache/

# Envs
.env
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store


# === Agregado por cleanup_temp.py ===
# Archivos del sistema
Thumbs.db
# Directorios temporales
data/temp/*
!data/temp/.gitkeep
data/temp_reports/*
!data/temp_reports/.gitkeep
# Cache de pipeline
data/temp/pipeline_cache/*
!data/temp/pipeline_cache/.gitkeep

# === Ignorar docs locales y datos ===
# Excluir completamente las guías locales
guides_md/

# Ignorar recursivamente el contenido de data/, pero permitir carpetas vacías
# usando archivos marcadores .gitkeep
data/**
!data/**/
!data/**/.gitkeep

# Carpetas y documentos ignorados por solicitud
mcp-server/
real_cases/
vision/
tests/*
!tests/.gitkeep
!tests/gps/
!tests/gps/*.py
!tests/agent/
!tests/agent/*.py

# Ignorar todos los .md en la raíz salvo README.md y BETTER_PRACTICES.md
/*.md
!/README.md
!/BETTER_PRACTICES.md
!/GUIA_IMPLEMENTACION_AGENTICO_RICK_GPS.md
